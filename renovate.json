{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "platformAutomerge": false,
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Group and automerge all non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Never propose major updates (avoid breaking changes)",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Keep Vite+, its Vite core alias, Vitest, and coverage packages in the same update group",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "vite-plus",
        "vite",
        "@voidzero-dev/vite-plus-core"
      ],
      "groupName": "vitest"
    }
  ]
}
