{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "platformAutomerge": false,
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Group and automerge all non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Propose major updates for review without automerging",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "vitest, its @vitest/* packages, and vite-plus (which vendors its own internal vitest) are tightly-coupled peer dependencies and must move together, or coverage-v8 vs vitest version mismatches break CI",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "vite-plus",
        "vite",
        "@voidzero-dev/vite-plus-core"
      ],
      "groupName": "vite-plus toolchain"
    }
  ]
}
