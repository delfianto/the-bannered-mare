{
  "name": "bannered-mare-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:gen": "openapi-typescript ../openapi.json -o ./src/api/schema.d.ts && vp fmt src/api/schema.d.ts",
    "build": "vue-tsc -b && vp build",
    "dev": "VITE_USE_MOCKS=false vp dev --host",
    "dev:mock": "VITE_USE_MOCKS=true vp dev --host",
    "fmt": "vp fmt src AGENTS.md vite.config.ts",
    "fmt:check": "vp fmt --check src AGENTS.md vite.config.ts",
    "lint": "vp lint",
    "lint:tailwind": "eslint src/",
    "lint:canonical": "bun scripts/canonical-classes.mjs",
    "lint:canonical:fix": "bun scripts/canonical-classes.mjs --fix",
    "preview": "vp preview",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "dompurify": "^3.4.16",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^15.0.2",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.2.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "^2.5.1",
    "daisyui": "^5.7.46",
    "eslint": "^10.11.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "happy-dom": "^20.14.5",
    "msw": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-terminal": "^1.4.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.3",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
