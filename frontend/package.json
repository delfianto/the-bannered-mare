{
  "name": "bannered-mare-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:gen": "openapi-typescript ../openapi.json -o ./src/api/schema.d.ts && vp fmt src/api/schema.d.ts",
    "build": "vue-tsc -b && vp build",
    "dev": "VITE_USE_MOCKS=false vp dev --host",
    "dev:mock": "VITE_USE_MOCKS=true vp dev --host",
    "fmt": "vp fmt src AGENTS.md vite.config.ts",
    "fmt:check": "vp fmt --check src AGENTS.md vite.config.ts",
    "lint": "vp lint",
    "lint:tailwind": "eslint src/",
    "lint:canonical": "bun scripts/canonical-classes.mjs",
    "lint:canonical:fix": "bun scripts/canonical-classes.mjs --fix",
    "preview": "vp preview",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "check": "vp check && bun run typecheck && bun run test:e2e:typecheck",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "bun run build && playwright test --ui",
    "test:e2e:typecheck": "vue-tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@vueuse/core": "^15.0.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/markdown-it": "^14.2.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-terminal": "^1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "js-yaml": "^5.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
