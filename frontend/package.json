{
  "name": "bannered-mare-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:gen": "openapi-typescript ../openapi.json -o ./src/api/schema.d.ts && vp fmt src/api/schema.d.ts",
    "build": "vue-tsc -b && vp build",
    "dev": "VITE_USE_MOCKS=false vp dev --host",
    "dev:mock": "VITE_USE_MOCKS=true vp dev --host",
    "fmt": "vp fmt src AGENTS.md vite.config.ts",
    "fmt:check": "vp fmt --check src AGENTS.md vite.config.ts",
    "lint": "vp lint",
    "lint:tailwind": "eslint src/",
    "lint:canonical": "bun scripts/canonical-classes.mjs",
    "lint:canonical:fix": "bun scripts/canonical-classes.mjs --fix",
    "preview": "vp preview",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "dompurify": "^3.4.9",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.2.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.3.14",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.4.11",
    "daisyui": "^5.6.16",
    "eslint": "^10.6.0",
    "eslint-plugin-tailwindcss": "^4.0.6",
    "happy-dom": "^20.10.6",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.0",
    "vite-plugin-terminal": "^1.4.0",
    "vite-plus": "^0.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "bun@1.4.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
