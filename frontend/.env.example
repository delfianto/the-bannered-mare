# The Bannered Mare — frontend environment variables.
# Copy to `.env.local` (gitignored) and adjust. All are optional.

# Backend origin for the typed API client + reachability probe. Empty uses
# same-origin / the Vite dev proxy; set it for a split-origin backend deploy.
VITE_API_URL=

# Serve MSW mocks instead of hitting the backend (disables the /api dev proxy).
VITE_USE_MOCKS=false

# Log every API request to the console (debugging aid).
VITE_DEBUG_REQUEST=false
