# Database
DATABASE_URL=postgresql://user:password@localhost:5432/candlekeep
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=3600
DATABASE__POOL_PRE_PING=true
DATABASE__ECHO=false           # Set to true for SQL query logging
DATABASE__ECHO_POOL=false      # Set to true for connection pool debugging

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# Storage
SEED_MODELS=false

# Models seeding
SEED_MODELS=false
SEED_MODELS_ANTHROPIC=false
SEED_MODELS_GOOGLE=false
SEED_MODELS_OLLAMA=false
SEED_MODELS_OPENAI=false
SEED_MODELS_OPENROUTER=false
SEED_MODELS_XAI=false

# Logging
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console
LOGGING__MONGO_ENABLED=true
LOGGING__MONGO_URI=mongodb://localhost:27017
LOGGING__MONGO_DATABASE=candlekeep_logs
LOGGING__LOG_HTTP_REQUESTS=true
LOGGING__LOG_LLM_CALLS=true
LOGGING__LOG_REQUEST_BODY=false
LOGGING__LOG_RESPONSE_BODY=false
LOGGING__REDACT_API_KEYS=true

# API Keys
OPENROUTER_API_KEY=sk-user_provided
ANTHROPIC_API_KEY=sk-ant-user_provided
OPENAI_API_KEY=sk-proj-user_provided
GOOGLE_API_KEY=user_provided
ELEVEN_LABS_API_KEY=sk_user_provided
