# Database
DATABASE_URL=postgresql://user:password@localhost:5432/candlekeep
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=3600
DATABASE__POOL_PRE_PING=true
DATABASE__ECHO=false           # Set to true for SQL query logging
DATABASE__ECHO_POOL=false      # Set to true for connection pool debugging

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# Storage
SEED_MODELS=false

# Models seeding
SEED_MODELS=false
SEED_MODELS_ANTHROPIC=false
SEED_MODELS_GOOGLE=false
SEED_MODELS_OLLAMA=false
SEED_MODELS_OPENAI=false
SEED_MODELS_OPENROUTER=false
SEED_MODELS_XAI=false

# RAG / Embeddings
RAG__ENABLED=false
RAG__EMBEDDING__PROVIDER=llamacpp            # llamacpp | openai (OpenAI-compatible) | ollama | huggingface (TEI native)
RAG__EMBEDDING__MODEL=embeddinggemma
RAG__EMBEDDING__DIMENSIONS=768               # must match the pinned vector(768) column
RAG__EMBEDDING__LLAMACPP_URL=http://localhost:8080
# HF Text Embeddings Inference — native /embed (TEI has no OpenAI-compatible rerank route).
# RAG__EMBEDDING__HUGGINGFACE_URL=http://localhost:8090
# RAG__EMBEDDING__OLLAMA_URL=http://localhost:11434
# RAG__EMBEDDING__OPENAI_URL=https://api.openai.com/v1
# RAG__EMBEDDING__OPENAI_KEY_ENV=OPENAI_API_KEY
# Prompt prefixes default to EmbeddingGemma's retrieval prompts; override only for a different model.
# RAG__EMBEDDING__QUERY_PREFIX="task: search result | query: "
# RAG__EMBEDDING__DOCUMENT_PREFIX="title: none | text: "

# Cross-encoder reranker — dedicated TEI instance, native /rerank. Off by default.
# When enabled, the vector similarity_threshold is bypassed (wide net) and the
# reranker score becomes the relevance floor instead.
# RAG__RERANK__ENABLED=false
# RAG__RERANK__HUGGINGFACE_URL=http://localhost:8091
# RAG__RERANK__MODEL=BAAI/bge-reranker-v2-m3
# RAG__RERANK__CANDIDATES=30                    # vector hits pulled before reranking down to max_results
# RAG__RERANK__SCORE_THRESHOLD=0.3              # min reranker score (0-1) to keep a hit

# Logging
LOGGING__LEVEL=INFO
LOGGING__FORMAT=console
LOGGING__MONGO_ENABLED=true
LOGGING__MONGO_URI=mongodb://localhost:27017
LOGGING__MONGO_DATABASE=candlekeep_logs
LOGGING__LOG_HTTP_REQUESTS=true
LOGGING__LOG_LLM_CALLS=true
LOGGING__LOG_REQUEST_BODY=false
LOGGING__LOG_RESPONSE_BODY=false
LOGGING__REDACT_API_KEYS=true

# API Keys
OPENROUTER_API_KEY=sk-user_provided
ANTHROPIC_API_KEY=sk-ant-user_provided
OPENAI_API_KEY=sk-proj-user_provided
GOOGLE_API_KEY=user_provided
ELEVEN_LABS_API_KEY=sk_user_provided
