# Python bytecode
__pycache__/
*.py[codz]

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Virtual environment & secrets
.venv/
.env

# Direnv (machine specific)
.envrc
.direnv

# Tests & coverage (pytest, coverage)
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tooling caches (ruff)
.ruff_cache/

# Logs
*.log

# Editors / IDEs
.idea/
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# --- The Bannered Mare specific ---

# Storage now lives at the repo root under STORAGE_PATH (default ./storage) and is
# ignored there — see the root .gitignore. Nothing binary is stored under backend/.

# Stray local SQLite/DB files (Postgres is the real database)
*.db
*.sqlite

# Local reference material (presets, ST source, etc.), kept locally only
refs/

# Claude Code: track shared project config (settings.json + hooks),
# ignore personal permissions and machine-local skills
.claude/*
!.claude/settings.json
!.claude/hooks/
